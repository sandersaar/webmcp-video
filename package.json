{
  "name": "webmcp-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "22.23.1",
    "pnpm": "10.31.0"
  },
  "packageManager": "pnpm@10.31.0",
  "imports": {
    "#video/*": "./src/*"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/*.test.ts",
    "test:browser": "playwright test",
    "verify:versions": "node scripts/verify-versions.mjs",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "verify:tools": "node scripts/verify-tool-surface.mjs",
    "verify:public": "node scripts/verify-public-boundary.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:commit": "pnpm verify:versions && pnpm typecheck && pnpm test:unit && pnpm build && pnpm verify:contracts && pnpm verify:tools && pnpm verify:public && pnpm verify:bundle",
    "verify:all": "pnpm verify:commit && pnpm test:browser",
    "verify:clean-clone": "node scripts/verify-clean-clone.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.0",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "4.0.18"
  }
}
